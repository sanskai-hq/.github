{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["deps"],
  "prConcurrentLimit": 5,
  "automerge": false,
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions digests"
    }
  ]
}
